# The house link (vendor/sdv-everyware/everyware/interfaces/house): the panel (vendor) serves it,
# the dashboard bundle calls it. Shaped as a HAL (system/sepolicy private/hal_threadnetwork.te),
# but not one: a hal_*_server may not open sockets or the audio device, and the panel does both.
attribute everyware_house_client;
attribute everyware_house_server;
type everyware_house_service, service_manager_type;
