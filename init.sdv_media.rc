# The root init (androidboot.init_rc): init reads this file and nothing else, so every rc the
# board needs is imported here by name.

import /system/etc/init/init.sdv_core_base.rc

import /vendor/etc/init/android.sdv.hardware.security.keymint-service.nonsecure.rc

import /vendor/etc/init/init.sdv_db845c.rc
import /vendor/etc/init/init.db845c.usb.rc
import /vendor/etc/init/dlkm_loader.rc
import /vendor/etc/init/allocator.rc
import /vendor/etc/init/bdaddr.rc
import /vendor/etc/init/ethaddr.rc
import /vendor/etc/init/power-default.rc
import /vendor/etc/init/power.stats-default.rc

on boot
    start console